{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/fetch-welplan-menu.js": { "maxDuration": 30 },
    "api/scheduled-welplan-menu.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/scheduled-welplan-menu",
      "schedule": "10 22 * * 0-4"
    },
    {
      "path": "/api/scheduled-meal-groups",
      "schedule": "0 3 * * 1-5"
    }
  ]
}
